# ===== 运行模式 =====
# offline：无 Key 端到端跑通（启发式规则 + 内置演示语料，0 token）
# online ：OpenAI 兼容 API（DeepSeek / 通义 / OpenAI 可切换）
DR_MODE=offline

# ===== 在线 LLM（OpenAI 兼容协议）=====
DR_LLM_BASE_URL=https://api.deepseek.com/v1
DR_LLM_API_KEY=
DR_LLM_MODEL=deepseek-chat
DR_LLM_TIMEOUT=60

# ===== 在线搜索（真实检索）=====
# demo：内置演示数据；tavily：真实在线搜索（在线评测必须用真实搜索）
DR_SEARCH_PROVIDER=demo
DR_TAVILY_API_KEY=

# ===== 在线评测成本核算（可选，两者都填才计算）=====
# 单位：每 100 万 token 的价格；未配置时报告标记 NOT_MEASURED
DR_LLM_PRICE_INPUT_PER_1M=
DR_LLM_PRICE_OUTPUT_PER_1M=

# ===== 知识库 =====
# full 双路在线评测必须指向真实语料；默认 data/corpus 是演示快照，会被 preflight 拒绝
DR_KB_ENABLED=true
DR_KB_CORPUS_DIR=./data/corpus
DR_KB_CORPUS_VERSION=unversioned
DR_KB_CORPUS_DESCRIPTION=
DR_MCP_KB_ENABLED=true
DR_RAG_TOP_K=8

# ===== 护栏 =====
DR_MAX_STEPS=24
DR_MAX_PLAN_ROUNDS=2
DR_MAX_SUBTASKS=8
DR_EVIDENCE_BUDGET=24
